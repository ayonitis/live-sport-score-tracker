# Copy this file to .env (never commit .env) and fill in your own values.

# Postgres connection string used by Drizzle / pg
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DB_NAME

# Rugby data (API-Sports Rugby). Free key: https://dashboard.api-football.com/register
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
API_SPORTS_KEY=040c6f46f326054d626a631f2f128fc0

# Optional: seconds between provider refreshes for today's rugby fixtures (minimum 30, default 90).
# Raise this on the free plan (100 requests/day), for example 300.
# RUGBY_LIVE_REVALIDATE_SECONDS=300

# Formula 1 data (Jolpica-F1) needs no API key.
# Optional: point at a different Ergast-compatible F1 API.
# F1_API_BASE_URL=https://api.jolpi.ca/ergast/f1
